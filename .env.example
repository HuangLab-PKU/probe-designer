# Example environment file for probe-designer.
# Copy to `.env` (not committed) and fill in your own values.
#
# These are optional but strongly recommended for NCBI Entrez queries —
# without credentials NCBI enforces stricter rate limits.

ENTREZ_EMAIL=your-email@example.com
ENTREZ_API_KEY=your_ncbi_api_key_here

# Optional: local BLAST database path (falls back to online BLAST when unset)
# BLAST_DB=/data/blast/refseq_rna

# Optional: local genome FASTA (falls back to Ensembl REST when unset)
# GENOME_FASTA=/data/genomes/GRCh38.fa
